NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/repowise
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
GITHUB_API_URL=https://api.github.com
# Optional but recommended for GitHub API rate limits.
GITHUB_TOKEN=
AI_SERVICE_URL=http://localhost:8000
# Must exactly match AI_SERVICE_API_KEY in ai-service/.env.
AI_SERVICE_API_KEY=replace-with-a-long-random-service-key
